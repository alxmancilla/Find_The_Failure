# Find the Failure — centralized configuration.
# Copy this file to .env and set MONGO_URI for the mode you want.

# ── Option A: Local MongoDB Atlas Local (Docker) ──────────────────────────────
# Single-node replica set; directConnection=true is required.
MONGO_URI=mongodb://localhost:27017/find_the_failure?directConnection=true

# ── Option B: MongoDB Atlas (cloud) ───────────────────────────────────────────
# Use your cluster's SRV connection string. Do NOT include directConnection.
# Keep the /find_the_failure database name in the path.
# MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<cluster>.xxxxx.mongodb.net/find_the_failure?retryWrites=true&w=majority

PORT=4000

# Connection settings. appName identifies this app in Atlas monitoring and logs.
MONGO_APP_NAME=find-the-failure
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Related-context retrieval for the Investigation Workbench.
# Options: atlas-search, atlas-rerank, vector-rerank, auto
ATLAS_RETRIEVAL_MODE=atlas-search

# Only enable on Atlas projects configured for Automated Embedding / Native Reranking.
# This creates a vectorSearch index with an autoEmbed field over operational_knowledge.text.
ENABLE_ATLAS_AUTO_EMBED_INDEX=false
